[Unit]
Description=Piloto incremental controlado do PNCP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Área de Trabalho/desafio-contratacoes/rag-grande-desafio-grupo03-contratacoes-publicas
EnvironmentFile=%h/.config/pncp-incremental-pilot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m src.fetch_incremental --resource contratacao --start-date ${PNCP_START_DATE} --end-date ${PNCP_END_DATE} --uf RJ --modality ${PNCP_MODALITY} --db-path ${PNCP_DB_PATH} --job-name ${PNCP_JOB_NAME} --worker-id systemd-online-pilot --online-pilot --resume
Restart=on-failure
RestartSec=1800
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp
PrivateTmp=false

[Install]
WantedBy=default.target
