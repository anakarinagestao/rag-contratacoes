# Banco relacional local
DATABASE_URL=sqlite:///./app.db

# Camada normalizada consultada em modo somente leitura pelas rotas SQL.
# Gere esta base com `python -m src.normalize_pncp` antes de habilitar as rotas.
NORMALIZED_DATABASE_URL=sqlite:///./data/normalized/pncp_rj_normalized.db

# Diagnóstico de desempenho de POST /query/ask no terminal do Uvicorn
RAG_PERF_LOG_ENABLED=false
RAG_LLM_HTTP_LOG_ENABLED=false
RAG_FAISS_INDEX_DIR=data/index/faiss/v1

# Provedor principal compartilhado entre Query Analyzer e geração RAG.
# Para usar somente sua conta OpenAI, selecione openai e fallback none.
ECOA_TIMEOUT_SECONDS=30
LLM_PRIMARY_PROVIDER=ecoa
LLM_PRIMARY_OPENAI_MODEL=gpt-4.1-mini
LLM_PRIMARY_GROQ_MODEL=openai/gpt-oss-120b
# Fallback opcional quando o provedor principal é Ecoa.
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_OPENAI_MODEL=gpt-4.1-mini
LLM_FALLBACK_GROQ_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_TIMEOUT_SECONDS=45
GROQ_API_KEY=
OPENAI_API_KEY=

# Embeddings. Para usar somente sua conta OpenAI, selecione openai e mantenha
# um índice separado de qualquer geração criada pelo Ecoa.
EMBEDDING_PROVIDER=ecoa
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60

# Compatibilidade temporária com o fallback OpenAI anterior, exclusivo do Analyzer.
ANALYZER_OPENAI_FALLBACK_ENABLED=false
ANALYZER_OPENAI_MODEL=gpt-4.1-mini
ANALYZER_ECOA_TIMEOUT_SECONDS=60

# Autenticação (preencha a chave somente no .env local)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
