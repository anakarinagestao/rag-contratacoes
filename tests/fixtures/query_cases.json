      "simulated_llm_output": {
        "route": "rag",
        "intent": "documental",
        "entity": "contratacao",
        "bases": ["agregada"],
        "filters": {
          "numero_controle_pncp": "00394502000144-1-009055/2026",
          "objeto": "manutenção dos elevadores"
        },
        "operations": ["count", "group_by"],
        "aggregation_field": null,
        "group_by": ["modalidade"],
        "order_by": [],
        "limit": null,
        "semantic_query": "serviços de manutenção dos elevadores",
        "needs_document_retrieval": true
      },
      "expected": {
        "route": "rag",
        "entity": "contratacao",
        "bases": ["agregada"],
        "operations_equals": [],
        "filters": {
          "numero_controle_pncp": "00394502000144-1-009055/2026",
          "objeto": null
        }
      },
      "note": "Regressão: rota documental recebia operações estruturadas e filtro textual excessivamente restritivo."
    },
    {
      "id": "hybrid_valor_equipamento_pncp",
      "question": "Para a contratação 00394452000103-1-015448/2026, informe a modalidade e o valor estimado e, com base no Termo de Referência, diga qual equipamento será adquirido.",
      "simulated_llm_output": {
        "route": "rag",
