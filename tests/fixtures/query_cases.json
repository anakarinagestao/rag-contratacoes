{
  "schemaVersion": "query_cases_v1",
  "description": "Casos determinísticos para validar a normalização do plano de consulta sem depender da Ecoa, do PNCP ou do banco.",
  "cases": [
    {
      "id": "structured_modalidade_2026",
      "question": "Quantas contratações por modalidade existem em 2026?",
      "simulated_llm_output": {
        "route": "structured",
        "intent": "aggregate",
        "entity": "contratacao",
        "bases": ["estruturada"],
        "filters": {"ano": 2026},
        "operations": ["count"],
        "aggregation_field": null,
        "group_by": ["modalidade"],
        "order_by": [],
        "limit": null,
        "semantic_query": null,
        "needs_document_retrieval": false
      },
      "expected": {
        "route": "structured",
        "entity": "contratacao",
        "bases": ["estruturada"],
        "operations_contains": ["count", "group_by"],
        "filters": {"ano": 2026}
      },
      "note": "Regressão: o modelo devolvia group_by sem a operação group_by."
    },
    {
      "id": "structured_maior_valor",
      "question": "Liste as 10 contratações de 2026 com maior valor estimado.",
      "simulated_llm_output": {
        "route": "structured",
        "intent": "lookup",
        "entity": "contratacao",
        "bases": ["estruturada"],
        "filters": {"ano": 2026},
        "operations": ["list"],
        "aggregation_field": null,
        "group_by": [],
        "order_by": [{"field": "valor_estimado", "direction": "desc"}],
        "limit": 10,
        "semantic_query": null,
        "needs_document_retrieval": false
      },
      "expected": {
        "route": "structured",
        "entity": "contratacao",
        "bases": ["estruturada"],
        "operations_contains": ["list", "order_by"],
        "filters": {"ano": 2026}
      },
      "note": "Regressão: o modelo devolvia ordenação sem a operação order_by."
    },
    {
      "id": "rag_edital_manutencao_pncp",
